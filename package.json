{
  "name": "sidekick-controller-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "build:hosting": "npm run build && node scripts/prepare-cloudflare.mjs",
    "secret:put": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL -u CLOUDFLARE_API_TOKEN wrangler secret put --config wrangler.jsonc --profile 40for40",
    "deploy": "npm run build:hosting && env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL -u CLOUDFLARE_API_TOKEN wrangler deploy --profile 40for40"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.96",
    "@ai-sdk/google": "4.0.111",
    "@ai-sdk/openai": "4.0.108",
    "@ai-sdk/openai-compatible": "3.0.84",
    "@huggingface/transformers": "4.3.2",
    "@mlc-ai/web-llm": "0.2.87",
    "ai": "7.0.162",
    "kokoro-js": "1.2.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.183.1",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sidekick.js"
    }
  }
}

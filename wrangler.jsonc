{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sidekick",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-03",
  "main": "hosting/worker.ts",
  "assets": {
    "directory": "./.cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "build40for40.com/sidekick", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/sidekick/*", "zone_name": "build40for40.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
